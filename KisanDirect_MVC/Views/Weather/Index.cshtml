@{
    ViewBag.Title = "Weather Forecast";
}

<style>
    .weather-page {
        background: linear-gradient(135deg, #eaf7ec, #f4f8fb);
        min-height: 80vh;
        padding: 35px 15px;
    }

    .weather-card {
        max-width: 1050px;
        margin: auto;
        background: white;
        padding: 30px;
        border-radius: 20px;
        box-shadow: 0 8px 28px rgba(0,0,0,.09);
    }

    .weather-title {
        color: #167542;
        text-align: center;
        font-weight: bold;
        margin-bottom: 8px;
    }

    .subtitle {
        text-align: center;
        color: #64748b;
    }

    .clock-panel {
        background: #153f31;
        color: white;
        border-radius: 14px;
        padding: 18px;
        text-align: center;
        margin: 22px 0;
    }

    .clock-time {
        font-size: 32px;
        font-weight: bold;
        letter-spacing: 1px;
    }

    .clock-date {
        margin-top: 5px;
    }

    .weather-search {
        display: flex;
        gap: 10px;
        max-width: 600px;
        margin: 22px auto;
    }

        .weather-search input {
            flex: 1;
            min-width: 0;
        }

    .weather-button {
        background: #198754;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: bold;
    }

        .weather-button:hover {
            background: #146c43;
        }

        .weather-button:disabled {
            opacity: .6;
            cursor: wait;
        }

    #message {
        text-align: center;
        margin: 15px;
        color: #475569;
    }

    .current-weather {
        background: linear-gradient(135deg, #e4f7ed, #e8f4ff);
        padding: 28px 15px;
        border-radius: 16px;
        text-align: center;
        margin-top: 20px;
    }

    .temperature {
        font-size: 48px;
        font-weight: bold;
        color: #167542;
    }

    .weather-icon {
        font-size: 55px;
    }

    .weather-details {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(145px, 1fr));
        gap: 14px;
        margin: 20px 0 28px;
    }

    .detail-box {
        background: #f7faf8;
        border: 1px solid #e0eee4;
        border-radius: 12px;
        padding: 18px 10px;
        text-align: center;
    }

    .detail-value {
        display: block;
        font-size: 20px;
        font-weight: bold;
        color: #167542;
        margin-top: 8px;
    }

    .section-title {
        color: #167542;
        font-weight: bold;
        margin-top: 28px;
    }

    .forecast-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(135px, 1fr));
        gap: 12px;
        margin-top: 16px;
    }

    .forecast-day {
        background: #f7faf8;
        border: 1px solid #e1eee4;
        padding: 17px 8px;
        border-radius: 12px;
        text-align: center;
    }

    .forecast-icon {
        font-size: 32px;
        margin: 10px 0;
    }

    .advice-box {
        border-radius: 12px;
        padding: 18px;
        margin-top: 14px;
        line-height: 1.7;
        background: #f1f8f2;
        border-left: 5px solid #198754;
    }

    .alert-box {
        border-radius: 12px;
        padding: 18px;
        margin-top: 14px;
        line-height: 1.7;
        background: #fff8e7;
        border-left: 5px solid #e0a020;
    }

    .small-note {
        color: #64748b;
        font-size: 12px;
        margin-top: 15px;
    }

    @@media (max-width: 600px) {
        .weather-card {
            padding: 18px 13px;
        }

        .weather-search {
            flex-direction: column;
        }

        .temperature {
            font-size: 40px;
        }

        .clock-time {
            font-size: 27px;
        }
    }
</style>

<div class="weather-page">
    <div class="weather-card">

        <h2 class="weather-title">🌦️ Weather &amp; Farming Dashboard</h2>

        <p class="subtitle">
            Real-time weather information and useful guidance for farmers
        </p>

        <div class="clock-panel">
            <div id="currentDay">Loading day...</div>
            <div id="currentDate" class="clock-date">Loading date...</div>
            <div id="liveClock" class="clock-time">--:--:--</div>
            <small>Current time on your device</small>
        </div>

        <div class="weather-search">
            <input type="text"
                   id="city"
                   class="form-control"
                   placeholder="Enter city, e.g. Mumbai"
                   value="Mumbai" />

            <button type="button"
                    class="weather-button"
                    id="checkButton"
                    onclick="getWeather()">
                Check Weather
            </button>
        </div>

        <p id="message" role="status">
            Loading weather information...
        </p>

        <div id="weatherResult" style="display:none">

            <div class="current-weather">
                <h3 id="cityName">City</h3>
                <div id="weatherIcon" class="weather-icon">🌤️</div>
                <div id="temperature" class="temperature">--°C</div>
                <h4 id="condition">Weather condition</h4>
                <p id="weatherUpdated">Weather update time loading...</p>
            </div>

            <div class="weather-details">
                <div class="detail-box">
                    💧 Humidity
                    <span class="detail-value" id="humidity">--%</span>
                </div>

                <div class="detail-box">
                    💨 Wind Speed
                    <span class="detail-value" id="wind">-- km/h</span>
                </div>

                <div class="detail-box">
                    🌡️ Feels Like
                    <span class="detail-value" id="feelsLike">--°C</span>
                </div>

                <div class="detail-box">
                    🌧️ Current Precipitation
                    <span class="detail-value" id="precipitation">-- mm</span>
                </div>
            </div>

            <h3 class="section-title">📅 5-Day Weather Forecast</h3>
            <div id="forecast" class="forecast-grid"></div>

            <h3 class="section-title">⚠️ Rain &amp; Weather Alerts</h3>
            <div id="alerts"></div>

            <h3 class="section-title">🌱 Farming Advice</h3>
            <div id="farmingAdvice" class="advice-box"></div>

            <p class="small-note">
                Weather data provided by Open-Meteo. Forecasts are estimates
                and may change. Follow official local advisories during
                severe weather.
            </p>
        </div>

        <p class="subtitle" style="margin-top:25px">
            🌾 Kisan Direct | Connecting Farmers and Buyers
        </p>

    </div>
</div>

<script>
        function updateLiveClock() {
            var now = new Date();

            var dayElement = document.getElementById("currentDay");
            var dateElement = document.getElementById("currentDate");
            var clockElement = document.getElementById("liveClock");

            if (dayElement) {
                dayElement.innerText = now.toLocaleDateString("en-IN", {
                    weekday: "long"
                });
            }

            if (dateElement) {
                dateElement.innerText = now.toLocaleDateString("en-IN", {
                    day: "2-digit",
                    month: "long",
                    year: "numeric"
                });
            }

            if (clockElement) {
                clockElement.innerText = now.toLocaleTimeString("en-IN", {
                    hour: "2-digit",
                    minute: "2-digit",
                    second: "2-digit",
                    hour12: true
                });
            }
        }

        updateLiveClock();
        setInterval(updateLiveClock, 1000);

        function weatherDescription(code) {
            if (code === 0) return ["Clear Sky", "☀️"];
            if (code === 1) return ["Mainly Clear", "🌤️"];
            if (code === 2) return ["Partly Cloudy", "⛅"];
            if (code === 3) return ["Overcast", "☁️"];
            if (code === 45 || code === 48) return ["Foggy", "🌫️"];

            if ([51, 53, 55, 56, 57].includes(code))
                return ["Drizzle", "🌦️"];

            if ([61, 63, 65, 66, 67, 80, 81, 82].includes(code))
                return ["Rain", "🌧️"];

            if ([71, 73, 75, 77, 85, 86].includes(code))
                return ["Snow", "❄️"];

            if ([95, 96, 99].includes(code))
                return ["Thunderstorm", "⛈️"];

            return ["Weather information", "🌡️"];
        }

        function formatLocalWeatherTime(time, timezone) {
            if (!time) return "Not available";

            try {
                var date = new Date(time);

                if (isNaN(date.getTime())) {
                    return time.replace("T", " ") + " (city local time)";
                }

                return new Intl.DateTimeFormat("en-IN", {
                    timeZone: timezone,
                    day: "2-digit",
                    month: "short",
                    year: "numeric",
                    hour: "2-digit",
                    minute: "2-digit",
                    hour12: true
                }).format(date);
            } catch (error) {
                return time.replace("T", " ") + " (city local time)";
            }
        }

        function addAdvice(list, text) {
            list.push(text);
        }

        function buildAdvice(data) {
            var advice = [];
            var alerts = [];

            var current = data.current;
            var daily = data.daily;

            if (current.precipitation >= 5) {
                alerts.push(
                    "Rain is currently reported at " +
                    current.precipitation +
                    " mm. Check field drainage and avoid unnecessary irrigation."
                );
            }

            var maxRain = 0;
            var rainValues = daily.precipitation_probability_max || [];

            for (var i = 0; i < rainValues.length; i++) {
                var chance = rainValues[i];

                if (chance !== null && chance > maxRain) {
                    maxRain = chance;
                }
            }

            var temperatures = daily.temperature_2m_max || [];
            var maxTemperature = temperatures.length
                ? Math.max.apply(null, temperatures)
                : 0;

            if (maxRain >= 70) {
                alerts.push(
                    "High chance of rain in the forecast (up to " +
                    maxRain +
                    "%). Check local forecasts before spraying crops or irrigating."
                );
            }

            if (maxTemperature >= 38) {
                alerts.push(
                    "High temperatures are forecast (up to " +
                    maxTemperature +
                    "°C). Monitor crops for heat stress and check soil moisture."
                );
            }

            if (current.weather_code >= 95) {
                alerts.push(
                    "Thunderstorm conditions are reported. Avoid exposed fields " +
                    "during lightning and follow official weather warnings."
                );
            }

            if (alerts.length === 0) {
                alerts.push(
                    "No high-threshold alert was identified by this simple " +
                    "dashboard. This does not guarantee that conditions are safe; " +
                    "check official local weather warnings."
                );
            }

            addAdvice(
                advice,
                "Irrigation: Check soil moisture before watering. If rain is " +
                "forecast, avoid unnecessary irrigation."
            );

            if (maxRain >= 50) {
                addAdvice(
                    advice,
                    "Rain preparation: Keep drainage channels clear and protect " +
                    "harvested produce from getting wet."
                );
            } else {
                addAdvice(
                    advice,
                    "Rain planning: Review the latest local forecast before " +
                    "irrigation, fertilizer application, or pesticide spraying."
                );
            }

            if (maxTemperature >= 35) {
                addAdvice(
                    advice,
                    "Heat care: Monitor crops during hot periods and maintain " +
                    "suitable soil moisture according to crop needs."
                );
            } else {
                addAdvice(
                    advice,
                    "Crop monitoring: Check leaves and soil regularly for signs " +
                    "of water stress, pests, or disease."
                );
            }

            var alertsElement = document.getElementById("alerts");
            var adviceElement = document.getElementById("farmingAdvice");

            if (alertsElement) {
                alertsElement.innerHTML = alerts.map(function (item) {
                    return '<div class="alert-box">⚠️ ' + item + '</div>';
                }).join("");
            }

            if (adviceElement) {
                adviceElement.innerHTML = advice.map(function (item) {
                    return '<div>• ' + item + '</div>';
                }).join("");
            }
        }

        async function getWeather() {
            var cityElement = document.getElementById("city");
            var message = document.getElementById("message");
            var result = document.getElementById("weatherResult");
            var button = document.getElementById("checkButton");

            if (!cityElement || !message || !result || !button) {
                return;
            }

            var city = cityElement.value.trim();

            if (!city) {
                message.innerText = "Please enter a city name.";
                result.style.display = "none";
                return;
            }

            message.innerText = "Loading real weather data...";
            button.disabled = true;
            result.style.display = "none";

            try {
                var geoUrl =
                    "https://geocoding-api.open-meteo.com/v1/search?name=" +
                    encodeURIComponent(city) +
                    "&count=1&language=en&format=json";

                var geoResponse = await fetch(geoUrl);

                if (!geoResponse.ok) {
                    throw new Error("Could not search for this city.");
                }

                var geoData = await geoResponse.json();

                if (!geoData.results || geoData.results.length === 0) {
                    throw new Error("City not found. Check the spelling.");
                }

                var place = geoData.results[0];

                var weatherUrl =
                    "https://api.open-meteo.com/v1/forecast?latitude=" +
                    place.latitude +
                    "&longitude=" +
                    place.longitude +
                    "&current=temperature_2m,relative_humidity_2m,apparent_temperature,is_day,precipitation,weather_code,wind_speed_10m" +
                    "&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max" +
                    "&timezone=auto&forecast_days=5";

                var weatherResponse = await fetch(weatherUrl);

                if (!weatherResponse.ok) {
                    throw new Error("Weather service is unavailable.");
                }

                var data = await weatherResponse.json();
                var current = data.current;
                var daily = data.daily;
                var description = weatherDescription(current.weather_code);

                document.getElementById("cityName").innerText =
                    place.name + (place.country ? ", " + place.country : "");

                document.getElementById("weatherIcon").innerText =
                    current.is_day === 0 && current.weather_code === 0
                    ? "🌙" : description[1];

                document.getElementById("temperature").innerText =
                    current.temperature_2m + "°C";

                document.getElementById("condition").innerText = description[0];

                document.getElementById("humidity").innerText =
                    current.relative_humidity_2m + "%";

                document.getElementById("wind").innerText =
                    current.wind_speed_10m + " km/h";

                document.getElementById("feelsLike").innerText =
                    current.apparent_temperature + "°C";

                document.getElementById("precipitation").innerText =
                    current.precipitation + " mm";

                document.getElementById("weatherUpdated").innerText =
                    "Weather data time (" + data.timezone + "): " +
                    formatLocalWeatherTime(current.time, data.timezone);

                var forecastHtml = "";

                for (var i = 0; i < daily.time.length; i++) {
                    var dayWeather = weatherDescription(daily.weather_code[i]);

                    var date = new Date(daily.time[i] + "T12:00:00");

                    var dayName = date.toLocaleDateString("en-IN", {
                        weekday: "short"
                    });

                    var rainChance = daily.precipitation_probability_max[i];

                    forecastHtml +=
                        '<div class="forecast-day">' +
                        '<strong>' + dayName + '</strong>' +
                        '<p>' + daily.time[i] + '</p>' +
                        '<div class="forecast-icon">' + dayWeather[1] + '</div>' +
                        '<p>' + dayWeather[0] + '</p>' +
                        '<strong>' + daily.temperature_2m_max[i] +
                        '° / ' + daily.temperature_2m_min[i] + '°</strong>' +
                        '<p>🌧️ Rain: ' +
                        (rainChance === null ? "N/A" : rainChance + "%") +
                        '</p></div>';
                }

                var forecastElement = document.getElementById("forecast");

                if (forecastElement) {
                    forecastElement.innerHTML = forecastHtml;
                }

                buildAdvice(data);

                result.style.display = "block";
                message.innerText = "Weather data updated successfully.";

            } catch (error) {
                message.innerText =
                    (error && error.message
                        ? error.message
                        : "Unable to load weather data.") +
                    " Please check your internet connection and try again.";

                result.style.display = "none";
            } finally {
                button.disabled = false;
            }
        }

        var cityInput = document.getElementById("city");

        if (cityInput) {
            cityInput.addEventListener("keydown", function (event) {
                if (event.key === "Enter") {
                    getWeather();
                }
            });
        }

        getWeather();
</script>