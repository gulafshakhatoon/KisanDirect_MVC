@{
    ViewBag.Title = "About Us";
}

<style>
    .about-page {
        font-family: Arial, sans-serif;
        background: #f5f8f2;
        color: #24352a;
        padding: 30px;
    }

    .about-hero {
        background: #174d32;
        color: white;
        text-align: center;
        padding: 45px 20px;
        border-radius: 12px;
    }

        .about-hero h1 {
            font-size: 36px;
            font-weight: bold;
        }

    .about-section {
        background: white;
        padding: 25px;
        margin-top: 25px;
        border-radius: 12px;
        border: 1px solid #dce8dc;
        line-height: 1.7;
    }

    .about-cards {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 20px;
        margin-top: 20px;
    }

    .about-card {
        background: #f8fbf6;
        border: 1px solid #dce8dc;
        border-radius: 10px;
        padding: 22px;
        width: 240px;
        text-align: center;
    }

        .about-card h3 {
            color: #247342;
        }

    .about-back {
        display: inline-block;
        margin-top: 25px;
        color: #247342;
        text-decoration: none;
        font-weight: bold;
    }
</style>

<div class="about-page">

    <div class="about-hero">
        <h1>About Kisan Direct 🌱</h1>

        <p>
            Connecting Farmers and Consumers
        </p>
    </div>

    <div class="about-section">
        <h2>Our Project</h2>

        <p>
            Kisan Direct is a web-based agricultural marketplace
            designed to help farmers showcase their crops and
            help consumers discover available agricultural products.
        </p>

        <p>
            The platform aims to encourage direct communication
            between farmers and consumers, promote price
            transparency, and reduce dependence on intermediaries.
        </p>
    </div>

    <div class="about-section">
        <h2>Our Mission</h2>

        <p>
            Our mission is to explore a simple digital solution
            that makes crop information easier to access and helps
            farmers and consumers connect more directly.
        </p>
    </div>

    <div class="about-section">
        <h2>Our Objectives</h2>

        <div class="about-cards">

            <div class="about-card">
                <h3>🌾 Support Farmers</h3>
                <p>
                    Provide a platform to display crops,
                    quantities and asking prices.
                </p>
            </div>

            <div class="about-card">
                <h3>🛒 Help Consumers</h3>
                <p>
                    Make crop information and listed prices
                    easier to explore.
                </p>
            </div>

            <div class="about-card">
                <h3>🤝 Direct Connection</h3>
                <p>
                    Help consumers contact farmers
                    to discuss purchases.
                </p>
            </div>

        </div>
    </div>

    <div class="about-section">
        <h2>Our Team</h2>

        <p>
            This project is developed by a team of three students
            as part of our college Community Engagement Project.
        </p>

        <p>
            Team Members: Add your three team members' names here.
        </p>
    </div>

    <a class="about-back"
       href="@Url.Action("Index", "Home")">
        ← Back to Home
    </a>

</div>