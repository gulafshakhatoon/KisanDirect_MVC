@{
    ViewBag.Title = "Community Research";
}

<style>
    .research-page {
        font-family: Arial, sans-serif;
        padding: 30px;
        background: #f5f8f2;
        color: #24352a;
        min-height: 75vh;
    }

    .research-header {
        background: #174d32;
        color: white;
        text-align: center;
        padding: 35px 15px;
        border-radius: 12px;
    }

        .research-header h1 {
            font-size: 32px;
            font-weight: bold;
        }

    .research-section {
        background: white;
        padding: 22px;
        margin-top: 25px;
        border-radius: 12px;
        border: 1px solid #dce8dc;
    }

    .research-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
    }

        .research-table th,
        .research-table td {
            border: 1px solid #dce8dc;
            padding: 13px;
            text-align: center;
        }

        .research-table th {
            background: #247342;
            color: white;
        }

    .research-note {
        background: #e4f1dc;
        padding: 16px;
        margin-top: 20px;
        border-radius: 8px;
        line-height: 1.6;
    }

    .research-back {
        display: inline-block;
        margin-top: 25px;
        color: #247342;
        text-decoration: none;
        font-weight: bold;
    }

    @@media (max-width: 600px) {
        .research-page {
            padding: 12px;
        }

        .research-table th,
        .research-table td {
            padding: 7px;
            font-size: 12px;
        }
    }
</style>

<div class="research-page">

    <div class="research-header">
        <h1>Our Community Research</h1>
        <p>Understanding crop prices and direct farmer connections</p>
    </div>

    <div class="research-section">
        <h2>About Our Research</h2>

        <p>
            Kisan Direct aims to connect farmers and consumers
            directly. Our project explores how transparent crop
            prices and direct communication may benefit both.
        </p>
    </div>

    <div class="research-section">
        <h2>Crop Price Comparison</h2>

        <p>
            The following figures are sample values used to
            demonstrate the price comparison feature.
        </p>

        <table class="research-table">
            <thead>
                <tr>
                    <th>Crop</th>
                    <th>Mandi Price/kg</th>
                    <th>City Price/kg</th>
                    <th>Proposed Direct Price/kg</th>
                </tr>
            </thead>

            <tbody>
                <tr>
                    <td>🍅 Tomato</td>
                    <td>₹18</td>
                    <td>₹45</td>
                    <td>₹28</td>
                </tr>

                <tr>
                    <td>🧅 Onion</td>
                    <td>₹15</td>
                    <td>₹35</td>
                    <td>₹22</td>
                </tr>

                <tr>
                    <td>🌾 Wheat</td>
                    <td>₹22</td>
                    <td>₹40</td>
                    <td>₹30</td>
                </tr>

                <tr>
                    <td>🥔 Potato</td>
                    <td>₹16</td>
                    <td>₹30</td>
                    <td>₹23</td>
                </tr>
            </tbody>
        </table>

        <div class="research-note">
            <strong>Note:</strong>
            These are illustrative sample prices, not verified
            live market rates or actual survey findings.
            Actual research data should be added before final submission.
        </div>
    </div>

    <div class="research-section">
        <h2>Our Project Objectives</h2>

        <ul>
            <li>Help consumers discover available crops.</li>
            <li>Make crop prices easier to compare.</li>
            <li>Help consumers contact farmers directly.</li>
            <li>Explore ways to reduce dependence on middlemen.</li>
        </ul>
    </div>

    <a class="research-back"
       href="@Url.Action("Index", "Home")">
        ← Back to Home
    </a>

</div>